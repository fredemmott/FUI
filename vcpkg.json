{
  "name": "fredemmott-gui",
  "version-string": "main",
  "license": "MIT",
  "dependencies": [
    "boost-container",
    "felly",
    "fmt",
    "tinyxml",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "pkgconf"
    },
    {
      "name": "wil",
      "platform": "windows"
    },
    {
      "name": "sdl3",
      "platform": "!windows",
      "features": [ "vulkan" ]
    },
    {
      "name": "yoga",
      "version>=": "3.2.1"
    }
  ],
  "default-features": [
    {
      "name": "direct2d",
      "platform": "windows"
    }
  ],
  "features": {
    "direct2d": {
      "description": "Enable support for Direct2D+DirectWrite+D3D11",
      "supports": "windows"
    },
    "icu": {
      "description": "Use the ICU library; on Windows, increases the binary size but reduces the minimum version",
      "dependencies": [ "icu" ]
    },
    "skia": {
      "description": "Enable support for Skia",
      "supports": "(windows & static) | !windows",
      "dependencies": [
        "icu",
        {
          "name": "skia",
          "default-features": false,
          "features": [
            {
              "name": "direct3d",
              "platform": "windows"
            },
            {
              "name": "vulkan",
              "platform": "!windows"
            },
            {
              "name": "fontconfig",
              "platform": "!windows"
            },
            {
              "name": "freetype",
              "platform": "!windows"
            },
            "harfbuzz",
            "icu"
          ]
        }
      ]
    }
  }
}
