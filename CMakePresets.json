{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_TOOLCHAIN_FILE": "third-party/vcpkg/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "clang-cl",
      "hidden": true,
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_MT": "mt",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER_LINKER": "MSVC"
      }
    },
    {
      "name": "Debug - default",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Debug - clang-cl",
      "inherits": "clang-cl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "Direct2D - Debug - clang-cl",
      "inherits": "clang-cl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_IMPLICIT_BACKENDS": "OFF",
        "ENABLE_DIRECT2D": "ON"
      }
    },
    {
      "name": "Direct2D - Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_IMPLICIT_BACKENDS": "OFF",
        "ENABLE_DIRECT2D": "ON"
      }
    },
    {
      "name": "Direct2D - ASAN",
      "inherits": "Direct2D - Release",
      "cacheVariables": {
        "ENABLE_HYBRID_CRT": "OFF",
        "CMAKE_CXX_FLAGS": "/fsanitize=address",
        "VCPKG_TARGET_TRIPLET": "x64-windows-asan-static"
      }
    },
    {
      "name": "Skia - Debug - clang-cl",
      "inherits": "clang-cl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_IMPLICIT_BACKENDS": "OFF",
        "ENABLE_SKIA": "ON"
      }
    },
    {
      "name": "Skia - Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_IMPLICIT_BACKENDS": "OFF",
        "ENABLE_SKIA": "ON"
      }
    },
    {
      "name": "linux-default",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_TOOLCHAIN_FILE": "third-party/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_BUILD_WITH_INSTALL_RPATH": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-g++",
      "hidden": true,
      "inherits": "linux-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "linux-clang",
      "hidden": true,
      "inherits": "linux-default",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "Linux - Debug - g++",
      "inherits": "linux-g++",
      "description": "Linux Debug build with g++-14 (Skia + Vulkan).",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SKIA": "ON"
      }
    },
    {
      "name": "Linux - Release - g++",
      "inherits": "linux-g++",
      "description": "Linux Release build with g++-14 (Skia + Vulkan).",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ENABLE_SKIA": "ON"
      }
    },
    {
      "name": "Linux - Debug - clang",
      "inherits": "linux-clang",
      "description": "Linux Debug build with clang/clang++ (Skia + Vulkan). Alt-compiler sanity check; g++ is the shipping toolchain on Linux.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SKIA": "ON"
      }
    }
  ]
}
